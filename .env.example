# ---------------------------------------------------------------------------
# WhatsApp Notification Router - Environment Variables
# ---------------------------------------------------------------------------

# Meta Cloud API Configuration
META_VERIFY_TOKEN=your_secure_random_string
META_ACCESS_TOKEN=your_permanent_page_access_token
META_PHONE_NUMBER_ID=your_production_phone_number_id

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Configuration (Optional, defaults to local SQLite)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
